    '(--no-color -C)'{-C,--no-color}'[Disable colored output]'
    '(--help -h)'{-h,--help}'[show this help message and exit]'
    '(--embedded-controller -e)'{-e+,--embedded-controller=}'[Specify embedded controller to use]':EC:'(acpi_ec ec_sys dev_port)'
