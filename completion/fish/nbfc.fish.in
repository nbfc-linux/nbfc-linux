set -l C002 "not $has_option -d --dsdt -D --dsdt-dir"
set -l C003 "not $has_option -j --json"
set -l C004 "$num_of_positionals -eq 1"
complete -c $prog -n $P -n $C000 -n $C001 -s d -l dsdt -d 'Use an alternative DSDT file' -Fr
complete -c $prog -n $P -n $C000 -n $C002 -s D -l dsdt-dir -d 'Use an alternative DSDT directory' -x -a '(__fish_complete_directories)'
complete -c $prog -n $P -n $C000 -n $C003 -s j -l json -d 'Use JSON output' -f
complete -c $prog -n $P -n $C004 -n $C000 -d Commands -f -a '(_nbfc_acpi_dump__command)'

# command nbfc xml2json
