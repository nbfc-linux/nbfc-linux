set -l C003 "not $has_option -a --algorithm"
set -l C004 "not $has_option --force"
complete -c $prog -n $P -n $C000 -n $C001 -n $C002 -s f -l fan -d 'Fan index (zero based)' -x -a '(nbfc complete-fans)'
